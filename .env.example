# Copy to .env (never commit .env) or export these in the process environment.
# Both are optional: the service boots and answers without them.
DECISION_API_BASE_URL=https://decision-api.example.invalid
DECISION_API_KEY=replace-with-your-key

# Optional runtime settings.
# HOST defaults to 127.0.0.1 (loopback only). PORT defaults to 8787.
# HOST=127.0.0.1
# PORT=8787
# DECISION_CONFIG_PATH=./config/decision.json
